<?xml version="1.0" encoding="utf-8"?>
<html xmlns="http://www.w3.org/1999/xhtml">
	<head>
		<meta http-equiv="content-type" content="application/xhtml+xml; charset=utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<script type="application/javascript"{jquery}</script>
		<script type="application/javascript">{jquery_tablesorter}</script>
		<script type="application/javascript"{jquery_flot}</script>
		<script type="application/javascript"{jquery_flot_pie}</script>
		<script type="application/javascript"{jquery_flot_resize}</script>
		{bootstrap_css}
		<script type="application/javascript">
			var MINOR_AUTHOR_PERCENTAGE = 1.00;

			$(document).ready(function() {{
				var isMinorPercentage = function() {{
					return parseFloat(this.innerHTML) < MINOR_AUTHOR_PERCENTAGE;
				}};

				var minorAuthorRows = function(table) {{
					return table.find("tbody tr td:last-child").filter(isMinorPercentage).parent();
				}};

				var idleRows = function(table) {{
					return table.find("tbody tr").filter(function() {{
						return $(this).find("td div").length == 0;
					}});
				}};

				var minorAuthorNames = minorAuthorRows($("table#blame")).find("td:first-child").map(function() {{
					return $(this).text();
				}}).get();

				var minorResponsibilities = $("div#responsibilities div.author").filter(function() {{
					return $.inArray($(this).find("span.name").text(), minorAuthorNames) >= 0;
				}});

				// Hidden rows would otherwise break the striping, as CSS cannot tell visible rows apart.
				var stripe = function(rows) {{
					rows.filter(":visible").each(function(i) {{
						$(this).toggleClass("odd", i % 2 == 1);
					}});
				}};

				// The button of a box stays disabled unless there is something for it to reveal.
				var setupToggle = function(box, hidden, onToggle) {{
					if (hidden.length == 0) {{
						return;
					}}

					hidden.hide();
					onToggle();
					box.find("button.btn").prop("disabled", false).click(function() {{
						var pressed = !$(this).hasClass("active");
						$(this).toggleClass("active", pressed).attr("aria-pressed", pressed);
						hidden.toggle(pressed);
						onToggle();
					}});
				}};

				$("table#changes, table#blame").each(function() {{
					var table = $(this);
					var restripe = function() {{
						stripe(table.find("tbody tr"));
					}};

					table.tablesorter({{
						sortList: [[0,0]],
						headers: {{
							0: {{ sorter: "text" }}
						}}
					}}).bind("sortEnd", restripe);

					setupToggle(table.closest("div.box"), minorAuthorRows(table), restripe);
					restripe();
				}});

				$("table#changes thead th, table#blame thead th").click(function() {{
					$(this).parent().find("th strong").remove();
					$(this).append(this.isReversed ? "<strong> &#x25b2;</strong>" : "<strong> &#x25bc;</strong>");
					this.isReversed = !this.isReversed;
				}});

				$("table#changes thead th:first-child, table#blame thead th:first-child").each(function() {{
					this.isReversed = true;
					$(this).append("<strong> &#x25bc;</strong>");
				}});

				$("div.box.timeline").each(function() {{
					var box = $(this);
					var restripe = function() {{
						box.find("table").each(function() {{
							stripe($(this).find("tbody tr"));
						}});
					}};

					setupToggle(box, idleRows(box.find("table")), restripe);
					restripe();
				}});

				setupToggle($("div#responsibilities"), minorResponsibilities, function() {{}});

				$("#blame_chart, #changes_chart").bind("plothover", function(event, pos, obj) {{
					if (obj) {{
						var selection = "table tbody tr td:contains(\"" + obj.series.label + "\")";
						var element = $(this).parent().find(selection);

						if (element) {{
							if (this.hoveredElement && this.hoveredElement.html() != element.parent().html()) {{
								this.hoveredElement.removeClass("piehover");
							}}

							element.parent().addClass("piehover");
							this.hoveredElement = element.parent();
						}}
					}} else if (this.hoveredElement) {{
						this.hoveredElement.removeClass("piehover");
					}}
				}});

				// Make sure the two pie charts use the same colors.
				if (window.changes_plot && window.blame_plot) {{
					var author_colors = {{}};
					$.each(changes_plot.getData(), function(i, v) {{
						author_colors[v["label"]] = v["color"];
					}});

					$.each(blame_plot.getData(), function(i, v) {{
						if (author_colors[v["label"]] != undefined) {{
							v["color"] = author_colors[v["label"]];
						}}
					}});

					blame_plot.setupGrid();
					blame_plot.draw();
				}}

				// Restyle pie chart legends.
				$("div.legend table").css("position", "relative");
				$("div.chart").resize(function() {{
					$(this).find("div.legend table").css("position", "relative");
				}});
			}});
		</script>
		<style type="text/css">
			body {{
				margin: 0;
				font-family: "Arial", sans-serif;
				background: linear-gradient(to right, #afbaba, #eae2e7, #afbaba);
			}}
			div.box {{
				margin: 2em;
				padding: 1em;
				border: 6px solid #e7e7e7;
				border-radius: 10px;
				background-color: #f4f4f4;
				box-shadow: 1px 1px 3px #666;
				font-size: small;
				text-align: center;
			}}
			div.logo img {{
				float: left;
				padding: 0 1em 0 0;
			}}
			div.logo p {{
				margin: 0;
				padding: 15px 0 0 0;
			}}
			h1 {{
				margin-top: 10px;
				font-size: 18px;
			}}
			h3 {{
				margin: 20px 0 8px 0;
				font-size: 16px;
			}}
			hr {{
				border: 3px solid #e7e7e7;
			}}
			button.btn.btn-primary {{
				margin-top: 10px;
				padding: 10px 25px 10px 15px;
				border-color: #e2b2a0;
				background-color: #e7b7a5;
				color: #333;
				font-weight: bold;
			}}
			button.btn.btn-primary:hover, button.btn.btn-primary.active {{
				border-color: #a77765;
				background-color: #b78775;
				color: #fff;
			}}
			button.btn span {{
				color: transparent;
			}}
			button.btn.active span {{
				color: #fff;
			}}
			div.table-responsive {{
				border: 0;
			}}
			table.table {{
				margin-bottom: 0;
				font-size: small;
			}}
			table.table > thead > tr > th, table.table > tbody > tr > td, table.table > tfoot > tr > td {{
				padding: 8px 12px;
				border: 1px solid #e8e8e8;
				vertical-align: middle;
			}}
			table.table > thead > tr > th, table.table > tfoot > tr > td {{
				border-width: 0;
				background-color: #e7b7a5;
			}}
			table.table > thead > tr > th:first-child {{
				border-top-left-radius: 10px;
			}}
			table.table > thead > tr > th:last-child {{
				border-top-right-radius: 10px;
			}}
			table#changes thead th:hover, table#blame thead th:hover {{
				background-color: #b78775;
				color: #fff;
				cursor: pointer;
			}}
			table.table > tbody > tr.odd > td {{
				background-color: #e9e9e9;
			}}
			table.table > tbody > tr.piehover > td {{
				background-color: #e7e8d8;
			}}
			table.timeline {{
				margin-bottom: 15px;
			}}
			table.timeline td.insertremove {{
				padding-left: 12px;
				padding-right: 12px;
			}}
			div.insert {{
				background-color: #8a8;
			}}
			div.remove {{
				background-color: #c77;
			}}
			div.insert, div.remove {{
				float: left;
				width: 5%;
				height: 100%;
				margin: 0;
				padding: 0;
			}}
			td img, h3 img {{
				margin-right: 0.5em;
				border-radius: 14px;
				vertical-align: middle;
				opacity: 0.85;
			}}
			td img {{
				width: 24px;
				height: 24px;
			}}
			h3 img {{
				width: 32px;
				height: 32px;
				border-radius: 16px;
			}}
			div.chart {{
				height: 300px;
				margin: 30px 15px 15px 15px;
			}}
			div.legend {{
				float: right;
				padding-bottom: 10px;
				pointer-events: none;
			}}
			div.legend > table > tbody > tr > td {{
				padding: 5px;
			}}
			div.legend > div, div.legend td.legendColorBox > div, div.legend td.legendColorBox > div > div {{
				border-radius: 3px;
			}}
			ul.list-group {{
				max-width: 60em;
				margin: 0 auto 15px auto;
				text-align: left;
			}}
			li.list-group-item {{
				padding: 6px 12px;
			}}
			li.list-group-item span.badge {{
				background-color: #b78775;
			}}
			li.violation-minimal {{
				background-color: #e9f1e4;
			}}
			li.violation-minor {{
				background-color: #f1f1e0;
			}}
			li.violation-medium {{
				background-color: #f7ecd6;
			}}
			li.violation-bad {{
				background-color: #f7dfd6;
			}}
			li.violation-severe {{
				background-color: #f4cfcf;
			}}
			span.label {{
				display: inline-block;
				margin: 2px;
				font-size: 90%;
			}}
			span.label-primary {{
				background-color: #b78775;
			}}
			@media (min-width: 992px) {{
				div.row {{
					display: flex;
				}}
				div.chart {{
					height: auto;
					max-height: 400px;
					margin: 0 30px 0 15px;
					padding: 15px;
				}}
			}}
			@media (max-width: 767px) {{
				div.box {{
					margin: 1em 0.5em;
					padding: 0.5em;
				}}
				div.logo img {{
					float: none;
					padding: 0;
				}}
			}}
		</style>
	</head>
	<body>
		<div><div class="box logo">
			<a href="https://github.com/ejwa/gitinspector"><img src="data:image/png;base64,{logo}" /></a>
			<p>{repo_text}<br />{logo_text}</p>
		</div></div>
