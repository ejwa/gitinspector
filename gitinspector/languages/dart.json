{
	"extensions": ["dart"],
	"comment": {"block": ["/*", "*/"], "line": "//"},
	"eloc": 500,
	"cyclomatic": {
		"branches": ["\\belse\\b", "\\bfor\\s*\\(.*\\)", "\\bif\\s*\\(.*\\)", "\\bcase\\s+.*:", "\\bdefault\\s*:", "\\bwhile\\s*\\(.*\\)"],
		"exits": ["\\bassert\\b", "\\bbreak\\b", "\\bcontinue\\b", "\\breturn\\b"]
	},
	"cognitive": {
		"nesting": ["\\bif\\s*\\(", "\\bfor\\s*\\(", "\\bforeach\\s*\\(", "\\bwhile\\s*\\(", "\\bswitch\\s*\\(", "\\bcatch\\s*\\(", "\\bdo\\s*\\{"],
		"continuation": ["\\belse\\b"]
	},
	"note": "The arms of a Dart switch expression are left uncounted, as their fat arrow is just as often the body of a function."
}
