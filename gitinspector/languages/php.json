{
	"extensions": ["php"],
	"comment": {"block": ["/*", "*/"], "line": "//"},
	"eloc": 500,
	"cyclomatic": {
		"branches": ["\\belse\\b", "\\belseif\\s*\\(.*\\)", "\\bfor\\s*\\(.*\\)", "\\bforeach\\s*\\(.*\\)", "\\bif\\s*\\(.*\\)", "\\bcase\\s+.*:", "\\bdefault\\s*:", "\\bwhile\\s*\\(.*\\)"],
		"exits": ["assert", "break", "continue", "return"]
	},
	"cognitive": {
		"nesting": ["\\bif\\s*\\(", "\\bfor\\s*\\(", "\\bforeach\\s*\\(", "\\bwhile\\s*\\(", "\\bswitch\\s*\\(", "\\bcatch\\s*\\("],
		"continuation": ["\\belseif\\b", "\\belse\\b"]
	}
}
